# Copy to Vercel → Project → Settings → Environment Variables (Production).
# Also copy locally to .env.local for `npm run dev`.

# --- Required for the RAG/agent answers ---
AVALAI_API_KEY=               # Aval AI key (embeddings + chat models: deepseek-v4-flash)

# --- Postgres (Neon) — contains the full docs index + rate_limits ---
DATABASE_URL="postgresql://..."

# --- Auth (NextAuth) — needed for login to work ---
AUTH_SECRET=                  # generate: npx auth secret
# Use EITHER GitHub OR Google OAuth (or both):
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Optional / legacy (not used by the copilot anymore) ---
# OPENROUTER_API_KEY=
# GAPGPT_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
